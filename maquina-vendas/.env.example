# Copie para .env e preencha. NUNCA publique o .env.

# simulacao = sem dinheiro real | real = contas de verdade (etapa 2)
MAQUINA_MODO=simulacao

# Travas de gasto (R$ por dia)
TETO_DIARIO_BRL=30
TETO_ABSOLUTO_BRL=100

# Senha do painel no celular (use uma frase longa). Se ficar vazio na simulação,
# a máquina cria uma e salva em dados/painel_token.txt
PAINEL_TOKEN=

# Textos dos anúncios escritos pelo Claude (opcional). Sem chave, usa modelos prontos.
ANTHROPIC_API_KEY=

# Avisos no celular pelo Telegram (opcional): crie um bot com o @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tokens dos avisos de venda (etapa 2)
HOTMART_HOTTOK=
KIWIFY_TOKEN=
EDUZZ_TOKEN=

# Simulação: segundos reais por hora simulada
SIM_SEGUNDOS_POR_HORA=5
